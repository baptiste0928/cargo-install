{
  "name": "cargo-install",
  "version": "3.4.0",
  "description": "GitHub action for cache-efficient Rust crates installation",
  "author": "baptiste0928",
  "license": "ISC",
  "scripts": {
    "check": "tsc",
    "lint": "oxlint --type-aware",
    "format": "prettier . !pnpm-lock.yaml !dist --write",
    "format:check": "prettier . !pnpm-lock.yaml !dist --check",
    "package": "esbuild src/index.ts --bundle --platform=node --target=node24 --outfile=dist/index.js"
  },
  "dependencies": {
    "@actions/cache": "^6.2.0",
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/http-client": "^4.0.1",
    "@actions/io": "^3.0.2",
    "chalk": "^6.0.0",
    "semver": "^7.8.5",
    "string-argv": "^0.3.2",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/semver": "^7.8.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "typescript": "^7.0.2"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  }
}
